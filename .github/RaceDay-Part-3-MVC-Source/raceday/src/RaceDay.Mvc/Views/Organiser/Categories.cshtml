@model List<Category>
@{ViewData["Title"]="Categories";}<div class="page-heading"><span class="eyebrow">EVENT SETUP</span><h1>Categories</h1><p>@ViewBag.EventName</p></div><div class="row g-4"><div class="col-lg-7"><div class="panel"><h2>Available categories</h2><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>Criteria</th><th>Fee</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.CategoryType</td><td>@(c.DistanceKm.HasValue?$"{c.DistanceKm} km":$"{c.MinimumAge?.ToString()??"Any"}–{c.MaximumAge?.ToString()??"Any"} years")</td><td>R @c.EntryFee.ToString("0.00")</td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="panel"><h2>Add category</h2><form asp-action="AddCategory" method="post"><input type="hidden" name="id" value="@ViewBag.EventId"/><label class="form-label">Category name</label><input class="form-control mb-3" name="Name" required/><label class="form-label">Category type</label><select class="form-select mb-3" name="CategoryType" id="catType"><option>Distance</option><option>Age</option></select><label class="form-label">Distance (km)</label><input class="form-control mb-3" name="DistanceKm" type="number" step=".1"/><div class="row"><div class="col"><label class="form-label">Minimum age</label><input class="form-control mb-3" name="MinimumAge" type="number"/></div><div class="col"><label class="form-label">Maximum age</label><input class="form-control mb-3" name="MaximumAge" type="number"/></div></div><label class="form-label">Entry fee (R)</label><input class="form-control mb-3" name="EntryFee" type="number" step=".01" value="0"/><button class="btn btn-dark w-100">Add category</button></form></div></div></div>