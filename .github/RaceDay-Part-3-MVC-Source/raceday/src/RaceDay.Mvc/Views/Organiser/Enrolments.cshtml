@model List<Enrolment>
@{ViewData["Title"]="Event enrolments";}<div class="page-heading"><span class="eyebrow">PARTICIPANT ROSTER</span><h1>Enrolments</h1><p>@ViewBag.EventName</p></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Entered</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.EnrolledAt.ToString("dd MMM yyyy")</td><td><span class="status @(e.Status=="Confirmed"?"status-confirmed":"status-pending")">@e.Status</span></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted p-3">No participants have entered this event yet.</p>}</div>