@model List<Enrolment>
@{ViewData["Title"]="Results entry";}<div class="page-heading"><span class="eyebrow">AFTER THE FINISH LINE</span><h1>Capture results</h1><p>@ViewBag.EventName · Add finish times and finishing positions for enrolled participants.</p></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time</th><th>Position</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td><span class="status status-pending">@e.Status</span></td><td colspan="4"><form asp-action="SaveResult" method="post" class="result-form"><input type="hidden" name="id" value="@ViewBag.EventId"/><input type="hidden" name="enrolmentId" value="@e.EnrolmentId"/><input class="form-control" name="finishTime" type="text" placeholder="00:48:22" required/><input class="form-control" name="position" type="number" min="1" value="1" required/><button class="btn btn-dark btn-sm">Publish</button></form></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted p-3">No enrolments are available for results.</p>}</div>