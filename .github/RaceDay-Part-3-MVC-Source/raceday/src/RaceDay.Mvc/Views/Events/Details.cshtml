@model EventDetail
@{ViewData["Title"]=Model.Name;}<a asp-action="Index" class="back-link">← All events</a><div class="detail-hero mt-3">@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@(Model.BannerImageUrl?.StartsWith("/") == true ? Configuration["RaceDayApi:BaseUrl"]?.TrimEnd('/') + Model.BannerImageUrl : Model.BannerImageUrl)" alt="Event banner"/>}else{<div class="detail-placeholder">@Model.EventType · @Model.DistanceKm km</div>}<div class="detail-copy"><span class="eyebrow">@Model.EventType.ToUpperInvariant() EVENT</span><h1>@Model.Name</h1><p>⌖ @Model.Location</p><p>◷ @Model.EventDate.ToString("dddd, dd MMMM yyyy · HH:mm")</p><div class="display-6 fw-bold">@Model.DistanceKm.ToString("0.#") <small class="fs-6">KM</small></div></div></div><div class="row g-4 mt-2"><div class="col-lg-7"><div class="panel"><h2>About this event</h2><p>@Model.Description</p><p class="text-muted small">Organised by @Model.OrganiserName</p></div></div><div class="col-lg-5"><div class="panel"><h2>Choose your category</h2>@if(Model.Categories.Count==0){<p class="text-muted">Categories have not been added yet.</p>}@foreach(var c in Model.Categories){<div class="category-row"><div><strong>@c.Name</strong><div class="small text-muted">@c.CategoryType · @((c.DistanceKm?.ToString("0.#")+" km")??(c.MinimumAge.HasValue||c.MaximumAge.HasValue?$"{c.MinimumAge?.ToString()??"Any"}–{c.MaximumAge?.ToString()??"Any"} years":"Open"))</div></div><div class="text-end"><strong>R @c.EntryFee.ToString("0.00")</strong>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enter" method="post"><input type="hidden" name="eventId" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-sm btn-dark mt-1">Enter</button></form>}</div></div>}@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-outline-dark w-100 mt-3" asp-controller="Organiser" asp-action="Categories" asp-route-id="@Model.EventId">Manage categories</a><form asp-action="UploadBanner" method="post" enctype="multipart/form-data" class="mt-3"><input type="hidden" name="id" value="@Model.EventId"/><label class="form-label">Upload event banner</label><input class="form-control mb-2" type="file" name="file" accept="image/png,image/jpeg,image/webp" required/><button class="btn btn-lime w-100">Upload banner</button></form>}</div></div></div>