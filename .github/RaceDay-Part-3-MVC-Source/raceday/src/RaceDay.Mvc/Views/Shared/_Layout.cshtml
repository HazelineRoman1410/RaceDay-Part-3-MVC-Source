<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><nav class="navbar navbar-expand-lg navbar-dark rd-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Events" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Discover races</a></li>@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Manage">Manage events</a></li>}@if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>}</ul><div class="d-flex align-items-center gap-2">@if(Context.Session.GetInt32("UserId")!=null){<span class="text-white-50 small">Hi, @Context.Session.GetString("Name")</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-lime btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav><main class="container py-4">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</main><footer class="container py-4 text-muted small border-top">RaceDay · Built for South Africa's running, walking and cycling community.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>