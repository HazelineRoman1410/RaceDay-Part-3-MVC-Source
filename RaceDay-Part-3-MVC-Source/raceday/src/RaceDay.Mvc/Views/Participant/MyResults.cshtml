@model List<Result>
@{ViewData["Title"]="My results";}<div class="page-heading"><span class="eyebrow">PERSONAL BESTS & MILESTONES</span><h1>My results</h1><p>Your race history, one finish line at a time.</p></div><div class="row g-3">@foreach(var r in Model){<div class="col-md-6 col-xl-4"><div class="panel result-card"><span class="badge activity">@r.CategoryName</span><h3 class="mt-3">@r.EventName</h3><p class="text-muted">@r.EventDate.ToString("dd MMM yyyy")</p><div class="result-time">@r.FinishTime.ToString(@"hh\:mm\:ss")</div><div class="event-meta"><span>Position <strong>#@r.Position</strong></span><span>of <strong>@r.TotalFinishers</strong></span></div></div></div>}@if(Model.Count==0){<div class="col-12"><div class="empty-state"><h3>Your race story starts here</h3><p>Once an organiser publishes your results, they will appear on this page.</p><a class="btn btn-dark" asp-controller="Events" asp-action="Index">Explore events</a></div></div>}</div>