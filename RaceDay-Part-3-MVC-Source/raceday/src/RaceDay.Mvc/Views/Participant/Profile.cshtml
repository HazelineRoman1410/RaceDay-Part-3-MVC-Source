@model ProfileVm
@{ViewData["Title"]="My profile";}<div class="page-heading"><span class="eyebrow">YOUR ACCOUNT</span><h1>Profile settings</h1><p>Keep your participant information up to date.</p></div><div class="panel form-panel">@if(!string.IsNullOrWhiteSpace(Model.ProfileImageUrl)){<img src="@(Model.ProfileImageUrl?.StartsWith("/") == true ? Configuration["RaceDayApi:BaseUrl"]?.TrimEnd('/') + Model.ProfileImageUrl : Model.ProfileImageUrl)" alt="Profile picture" class="profile-picture mb-3"/>}<form method="post"><input asp-for="ProfileImageUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label">First name</label><input asp-for="FirstName" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label">Last name</label><input asp-for="LastName" class="form-control"/></div></div><div class="mb-3"><label asp-for="Phone" class="form-label">Phone number</label><input asp-for="Phone" class="form-control"/></div><button class="btn btn-dark">Save profile</button></form><hr class="my-4"/><form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data"><label class="form-label">Upload profile picture</label><input class="form-control mb-3" type="file" name="file" accept="image/png,image/jpeg,image/webp" required/><div class="form-text mb-3">JPEG, PNG or WebP · maximum 5 MB. Uploads are sent to the API and stored using its configured storage provider.</div><button class="btn btn-outline-dark">Upload picture</button></form></div>