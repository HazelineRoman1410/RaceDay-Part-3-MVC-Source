@model List<Enrolment>
@{ViewData["Title"]="My events";}<div class="page-heading"><span class="eyebrow">YOUR RACE CALENDAR</span><h1>My events</h1><p>Every entry is a new goal to work towards.</p></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td><strong>@e.EventName</strong></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td><span class="status @(e.Status=="Confirmed"?"status-confirmed":"status-pending")">@e.Status</span></td><td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-dark">Event details</a></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted p-3">You have not entered an event yet. <a asp-controller="Events" asp-action="Index">Find your next race.</a></p>}</div>