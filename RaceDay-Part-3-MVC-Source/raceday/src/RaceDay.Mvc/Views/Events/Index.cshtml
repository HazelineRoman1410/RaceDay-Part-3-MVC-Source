@model List<EventSummary>
@{ViewData["Title"]="Discover events";}<section class="hero mb-4"><div class="hero-copy"><span class="eyebrow">FIND YOUR NEXT START LINE</span><h1>Every kilometre<br/>has a story.</h1><p>Discover South African running, walking and cycling events. Find your challenge and make race day yours.</p><a class="btn btn-lime btn-lg" href="#events">Explore events ↓</a></div><div class="hero-stats"><div><strong>@Model.Count</strong><span>Events listed</span></div><div><strong>3</strong><span>Ways to move</span></div><div><strong>1</strong><span>Community</span></div></div></section><div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3" id="events"><div><span class="eyebrow">THE STARTING LINE</span><h2 class="section-title">Upcoming events</h2></div>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-dark" asp-action="Create">＋ Create event</a>}</div><form class="filter-bar mb-4" method="get"><input class="form-control" name="search" placeholder="Search events" value="@ViewBag.Search"/><input class="form-control" name="location" placeholder="Location" value="@ViewBag.Location"/><select class="form-select" name="type"><option value="">All activities</option><option selected="@(ViewBag.Type=="Run")">Run</option><option selected="@(ViewBag.Type=="Walk")">Walk</option><option selected="@(ViewBag.Type=="Cycle")">Cycle</option></select><button class="btn btn-dark">Filter</button></form><div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-xl-4"><article class="event-card h-100">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img class="event-banner" src="@(e.BannerImageUrl?.StartsWith("/") == true ? Configuration["RaceDayApi:BaseUrl"]?.TrimEnd('/') + e.BannerImageUrl : e.BannerImageUrl)" alt="Banner for @e.Name"/>}else{<div class="event-banner banner-placeholder"><span>@e.EventType.ToUpperInvariant()</span><strong>@e.DistanceKm.ToString("0.#")<small> KM</small></strong></div>}<div class="p-4"><div class="d-flex justify-content-between mb-2"><span class="badge activity">@e.EventType</span><span class="text-muted small">@e.EventDate.ToString("dd MMM yyyy")</span></div><h3>@e.Name</h3><p class="text-muted mb-3">⌖ @e.Location</p><div class="event-meta"><span><strong>@e.DistanceKm.ToString("0.#")</strong> km</span><span><strong>@e.EnrolmentCount</strong> entries</span></div><a class="btn btn-outline-dark w-100 mt-3" asp-action="Details" asp-route-id="@e.EventId">View event</a></div></article></div>}@if(Model.Count==0){<div class="col-12"><div class="empty-state"><h3>No events found just yet</h3><p>Try a different filter, or check back soon.</p></div></div>}</div>