@model List<EventSummary>
@{ViewData["Title"]="Manage events";}<div class="page-heading d-flex justify-content-between flex-wrap gap-3"><div><span class="eyebrow">ORGANISER STUDIO</span><h1>Manage your events</h1><p>Keep your event details, categories and entries on track.</p></div><a class="btn btn-lime align-self-center" asp-action="Create">＋ Create event</a></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Entries</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><strong>@e.Name</strong><div class="text-muted small">@e.Location · @e.DistanceKm km @e.EventType</div></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td><span class="status status-confirmed">@e.EnrolmentCount</span></td><td><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-dark" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View</a><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@e.EventId">Edit</a><a class="btn btn-sm btn-outline-dark" asp-controller="Organiser" asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-sm btn-outline-dark" asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a><a class="btn btn-sm btn-outline-dark" asp-controller="Organiser" asp-action="Results" asp-route-id="@e.EventId">Results</a><form asp-action="Delete" method="post" onsubmit="return confirm('Delete this event?')"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted p-3">You have not created any events yet.</p>}</div>