@model List<EventSummary>
@{ViewData["Title"]="Organiser dashboard";}<div class="page-heading"><span class="eyebrow">YOUR RACE HQ</span><h1>Organiser dashboard</h1><p>A clear view of your events and the community joining you.</p></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>Events managed</span><strong>@Model.Count</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Total enrolments</span><strong>@ViewBag.Enrolments</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>@Model.Count(e=>e.EventDate>DateTime.Now)</strong></div></div></div><div class="d-flex justify-content-between mb-3"><h2 class="section-title">Your events</h2><a class="btn btn-dark" asp-controller="Events" asp-action="Create">Create event</a></div><div class="row g-3">@foreach(var e in Model){<div class="col-md-6"><div class="panel"><span class="badge activity">@e.EventType</span><h3 class="mt-2">@e.Name</h3><p class="text-muted">@e.EventDate.ToString("dd MMM yyyy") · @e.Location</p><div class="event-meta"><span><strong>@e.EnrolmentCount</strong> entries</span><span><strong>@e.DistanceKm</strong> km</span></div><div class="d-flex flex-wrap gap-2 mt-3"><a class="btn btn-sm btn-outline-dark" asp-controller="Organiser" asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-sm btn-outline-dark" asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a><a class="btn btn-sm btn-outline-dark" asp-controller="Organiser" asp-action="Results" asp-route-id="@e.EventId">Enter results</a></div></div></div>}</div>